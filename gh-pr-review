#!/usr/bin/env bash
# gh pr-review — AI code review for any GitHub PR
#
# Usage:
#   gh pr-review <PR-URL | PR-number> [options]
#   gh pr-review rounds <PR-URL | PR-number> [--json] [-u <login>]
#   gh pr-review --doctor
#
# Options:
#   --model <id>    Pi model ID (default: github-copilot/gpt-5.6-sol)
#   -u, --user <login>  gh account to use for this run only (global gh auth is untouched)
#   --no-post       Print review but don't post to GitHub
#   --skip-approach Skip the maintainer's approach pass; run the code review only
#   --instructions <text>  Extra guidance for both passes (a file: "$(cat notes.md)")
#   --decision <d>  comment | approve | request-changes (default: from "Ready to merge?")
#   -y, --yes       Skip confirmation prompts (a loop-check stop then exits 3, no new commits exits 5)
#   --check         Run only the loop check: print it and exit 0 (run), 3 (stop) or 5 (no new commits)
#   --json          With --check, print the decision as JSON
#   --force-round   Run a round even when the loop check stops it or nothing changed
#                   (in a terminal, without -y, both ask "Run round K anyway?" instead)
#   --full          Review the whole PR again (round 2 and later still re-check the earlier findings)
#   --clone <path>  Review in a worktree of this local clone (default: found under the config's roots, ~/repos)
#   --fresh         Review in a throwaway depth-50 clone in the run folder instead of a local clone
#   --doctor        Check all prerequisites and exit
#   -h, --help      Show this help
#
# Exit codes: 0 done, 1 error, 3 stopped by the loop check, 5 no new commits since the last round,
#   6 the rounds changed while the review ran (nothing posted, the session is kept).
#
# Examples:
#   gh pr-review https://github.com/owner/repo/pull/42
#   gh pr-review 42                # infers repo from the current directory
#   gh pr-review 42 --model github-copilot/claude-sonnet-5 -y
#
# Environment:
#   GH_PR_REVIEW_MODEL          Default model override (same as --model)
#   GH_PR_REVIEW_PI_EXTENSION   Path to a pi extension to load during the review
#   GH_PR_REVIEW_USER           Default gh account (same as --user)
#   GH_PR_REVIEW_STATE          State folder (default: ${XDG_STATE_HOME:-~/.local/state}/gh-pr-review)
#   GITHUB_TOKEN                For private repos (gh auth is usually sufficient)

set -euo pipefail

# ── lib ─────────────────────────────────────────────────────────────────────
# Follow symlinks to the real script (`gh extension install .` links it), then load lib/*.sh.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
	LINK=$(readlink "$SELF")
	if [[ "$LINK" == /* ]]; then SELF="$LINK"; else SELF="$(dirname "$SELF")/$LINK"; fi
done
LIB_DIR="$(cd "$(dirname "$SELF")" && pwd)/lib"
for LIB_FILE in "$LIB_DIR"/*.sh; do
	# shellcheck source=/dev/null
	source "$LIB_FILE"
done

# ── subcommands ─────────────────────────────────────────────────────────────
# A known first word is a subcommand; anything else is a PR to review.
case "${1:-}" in
rounds | status | show | shepherd | dash | gc)
	SUBCOMMAND="$1"
	shift
	if declare -F "cmd_${SUBCOMMAND}" >/dev/null; then
		"cmd_${SUBCOMMAND}" "$@"
		exit $?
	fi
	echo "gh pr-review ${SUBCOMMAND}: not yet available" >&2
	exit 1
	;;
esac

# ── defaults ────────────────────────────────────────────────────────────────
MODEL="${GH_PR_REVIEW_MODEL:-github-copilot/gpt-5.6-sol}"
POST_TO_PR=true
DECISION=
YES=false
DOCTOR=false
TARGET=""
SKIP_APPROACH=false
INSTRUCTIONS=""
GH_USER="${GH_PR_REVIEW_USER:-}"
CHECK_ONLY=false
CHECK_JSON=false
FORCE_ROUND=false
FULL_ROUND=false
FRESH=false
CLONE_OVERRIDE=""

# ── arg parsing ──────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
	case "$1" in
	--model | -m)
		[[ $# -lt 2 ]] && {
			echo "Error: --model requires a model ID" >&2
			exit 1
		}
		MODEL="$2"
		shift 2
		;;
	--user | -u)
		[[ $# -lt 2 ]] && {
			echo "Error: --user requires a gh login" >&2
			exit 1
		}
		GH_USER="$2"
		shift 2
		;;
	--instructions)
		[[ $# -ge 2 && -n "${2//[[:space:]]/}" && "$2" != --* ]] || {
			echo "Error: --instructions requires non-empty text (got: ${2:-nothing})" >&2
			exit 1
		}
		INSTRUCTIONS="$2"
		shift 2
		;;
	--skip-approach)
		SKIP_APPROACH=true
		shift
		;;
	--check)
		CHECK_ONLY=true
		shift
		;;
	--json)
		CHECK_JSON=true
		shift
		;;
	--force-round)
		FORCE_ROUND=true
		shift
		;;
	--full)
		FULL_ROUND=true
		shift
		;;
	--clone)
		[[ $# -ge 2 && -n "$2" ]] || {
			echo "Error: --clone requires the path of a local clone" >&2
			exit 1
		}
		CLONE_OVERRIDE="$2"
		shift 2
		;;
	--fresh)
		FRESH=true
		shift
		;;
	--no-post)
		POST_TO_PR=false
		shift
		;;
	--decision)
		[[ $# -ge 2 && "$2" =~ ^(comment|approve|request-changes)$ ]] || {
			echo "Error: --decision must be comment, approve or request-changes" >&2
			exit 1
		}
		DECISION="$2"
		shift 2
		;;
	-y | --yes)
		YES=true
		shift
		;;
	--doctor)
		DOCTOR=true
		shift
		;;
	-h | --help)
		sed -n '2,${/^#/!q;s/^# \{0,1\}//p;}' "$0"
		exit 0
		;;
	-*)
		echo "Unknown option: $1  (try --help)" >&2
		exit 1
		;;
	*)
		[[ -n "$TARGET" ]] && {
			echo "Extra argument: $1" >&2
			exit 1
		}
		TARGET="$1"
		shift
		;;
	esac
done

if [[ "$DOCTOR" == "false" && -z "$TARGET" ]]; then
	echo "Usage: gh pr-review <PR-URL | PR-number> [--model <id>] [--no-post] [--skip-approach] [-y] [--check [--json]] [--force-round] [--full] [--clone <path> | --fresh] [--doctor]" >&2
	exit 1
fi
if [[ "$FRESH" == "true" && -n "$CLONE_OVERRIDE" ]]; then
	echo "Error: --clone and --fresh don't go together" >&2
	exit 1
fi
if [[ "$CHECK_JSON" == "true" && "$CHECK_ONLY" == "false" ]]; then
	echo "Error: --json only goes with --check" >&2
	exit 1
fi
# With --check --json, stdout carries the JSON only: everything else goes to stderr, the JSON to fd 3.
exec 3>&1
[[ "$CHECK_JSON" == "true" ]] && exec 1>&2

# ── per-run gh account (env token only; never runs `gh auth switch`) ─────────
use_gh_user "$GH_USER"

# ── pr context ─────────────────────────────────────────────────────────────────────
# The author's description and the discussion, as files both passes read after forming their own view.
write_pr_context() {
	local dir="$1" json threads
	mkdir -p "$dir"
	printf '# %s\n\n%s\n' "$PR_TITLE" "$PR_BODY" >"$dir/pr-body.md"
	json=$(gh pr view "$PR_NUM" --repo "$GH_HOST_NAME/$OWNER/$REPO" --json comments,reviews) || {
		echo "Error: could not fetch the PR discussion (check gh auth and network)." >&2
		exit 1
	}
	printf '%s\n' "$json" >"$dir/discussion.json"
	# shortcut: the first 100 comments per thread only; page them if real threads run longer.
	# shellcheck disable=SC2016 # $owner etc. are GraphQL variables, not shell ones
	threads=$(gh api graphql --hostname "$GH_HOST_NAME" --paginate \
		-f owner="$OWNER" -f name="$REPO" -F number="$PR_NUM" -f query='
		query($owner: String!, $name: String!, $number: Int!, $endCursor: String) {
		  repository(owner: $owner, name: $name) { pullRequest(number: $number) {
		    reviewThreads(first: 100, after: $endCursor) {
		      pageInfo { hasNextPage endCursor }
		      nodes { path line originalLine isResolved isOutdated
		        comments(first: 100) { totalCount nodes { author { login } body createdAt } } } } } } }') || {
		echo "Error: could not fetch the PR review threads (check gh auth and network)." >&2
		exit 1
	}
	{
		echo "# Conversation"
		echo ""
		jq -r '
			[(.comments[] | {who: .author.login, kind: "comment", at: .createdAt, body}),
			 (.reviews[] | {who: .author.login, kind: .state, at: .submittedAt, body})]
			| map(select((.body // "") != "")) | sort_by(.at)
			| if length == 0 then "(no comments or review summaries)"
			  else map("## \(.who) · \(.kind) · \(.at)\n\n\(.body)\n") | join("\n") end
		' <<<"$json"
		echo ""
		echo "# Inline review threads"
		echo ""
		jq -rs '
			[.[].data.repository.pullRequest.reviewThreads.nodes[]]
			| if length == 0 then "(no inline review threads)" else map(
				(.line // .originalLine) as $line | .comments.nodes as $c
				| (if .isResolved then "resolved" elif .isOutdated then "outdated" else "open" end) as $state
				| "## \(.path)\(if $line then ":\($line)" else "" end) · \($state)\n\n"
				+ (if .isResolved then
					"\($c[0].author.login): \(($c[0].body // "") | gsub("\\s+"; " ") | .[0:200])"
					+ (.comments.totalCount - 1 | if . == 0 then "" elif . == 1 then " (1 reply)"
					   else " (\(.) replies)" end)
				  else $c | map("**\(.author.login)** · \(.createdAt)\n\n\(.body)") | join("\n\n") end)
				+ "\n") | join("\n") end
		' <<<"$threads"
		echo ""
		echo "_Resolved threads show only the first 200 characters of the finding._"
	} >"$dir/pr-discussion.md"
}

# ── passes ──────────────────────────────────────────────────────────────────────────
# One headless pi call: prompt file in, model output file out. A failed call stops the run.
run_pi() {
	if ! pi "${PI_ARGS[@]}" "$(cat "$1")" >"$2"; then
		echo "" >&2
		echo "Error: pi exited with a non-zero status." >&2
		echo "    Check the session directory for details: ${SESSION_DIR}" >&2
		exit 1
	fi
}

# The run's extra guidance as a prompt section. Empty in, empty out.
instructions_section() {
	[[ -z "$INSTRUCTIONS" ]] && return 0
	printf '## Reviewer instructions\n\n'
	printf 'The person running this review added these instructions. Follow them where they conflict '
	printf 'with the default checklist. The output format, the verdict line and the read-only rule '
	printf 'still apply. Use them, but do not quote or mention them in your reply: it may be posted '
	printf 'on the PR.\n\n%s\n\n' "$INSTRUCTIONS"
}

# The posted body: the head (the loop line, or a later round's progress lines: assemble_body), the approach section,
# then the code review, then one footer. Empty in, empty out. The code review starts with an invisible boundary line
# (code_review_boundary in lib/records.jq): the reader reads the code review from there, as the writer reads it.
assemble_review() { # <loop/head lines> <approach> <code-review>
	local parts=() part
	for part in "$1" "$2"; do [[ -n "$part" ]] && parts+=("$part"); done
	[[ -n "$3" ]] && parts+=($'<!-- gh-pr-review:code-review -->\n'"$3")
	[[ ${#parts[@]} -eq 0 ]] && return 0
	parts+=($'---\n'"*Review generated by gh pr-review · model: ${MODEL}*")
	printf '%s' "${parts[0]}"
	printf '\n\n%s' "${parts[@]:1}"
	printf '\n'
}
# ── end passes

# ── preflight ────────────────────────────────────────────────────────────────
PI_AUTH_FILE="${HOME}/.pi/agent/auth.json"
PREFLIGHT_FAILURES=0

pf_ok() {
	[[ "$DOCTOR" == "true" ]] && echo "✓ $1"
	return 0
}

pf_fail() {
	echo "✗ $1" >&2
	echo "  → $2" >&2
	PREFLIGHT_FAILURES=$((PREFLIGHT_FAILURES + 1))
}

run_preflight() {
	if command -v git &>/dev/null; then
		pf_ok "git installed"
	else
		pf_fail "git not found" \
			"macOS: xcode-select --install · Linux: install via your package manager"
	fi

	if command -v jq &>/dev/null; then
		pf_ok "jq installed"
	else
		pf_fail "jq not found" "macOS: brew install jq · Linux: apt/dnf install jq"
	fi

	if gh auth status -h github.com &>/dev/null; then
		pf_ok "gh authenticated"
	else
		pf_fail "gh not authenticated" "run: gh auth login"
	fi

	# --check reads GitHub only: it needs no model.
	[[ "$CHECK_ONLY" == "true" ]] && return 0

	if command -v pi &>/dev/null; then
		pf_ok "pi installed"
	else
		pf_fail "pi (pi-coding-agent) not found" \
			"run: npm install -g @earendil-works/pi-coding-agent  (requires Node 22+)"
	fi

	if [[ "$MODEL" == github-copilot/* ]]; then
		if command -v jq &>/dev/null && [[ -f "$PI_AUTH_FILE" ]] &&
			jq -e 'has("github-copilot")' "$PI_AUTH_FILE" &>/dev/null; then
			pf_ok "pi has GitHub Copilot credentials"
		else
			pf_fail "pi is not logged in to GitHub Copilot (model: ${MODEL})" \
				"run pi, then /login and pick GitHub Copilot — requires an active Copilot subscription"
		fi
	fi
}

run_preflight

if [[ "$DOCTOR" == "true" ]]; then
	if [[ "$PREFLIGHT_FAILURES" -eq 0 ]]; then
		echo ""
		echo "All checks passed — try: gh pr-review <PR-URL | PR-number>"
		exit 0
	fi
	exit 1
fi

if [[ "$PREFLIGHT_FAILURES" -gt 0 ]]; then
	echo "" >&2
	echo "Fix the issues above, then re-check with: gh pr-review --doctor" >&2
	exit 1
fi

# ── resolve owner/repo/PR number ─────────────────────────────────────────────
resolve_target "$TARGET"
# The PR's state folder: its runs, its lock, pr.json and the last loop check (lib/state.sh).
PR_STATE_DIR=$(pr_state_dir "$GH_HOST_NAME" "$OWNER" "$REPO" "$PR_NUM") || exit 1

# ── fetch PR metadata ────────────────────────────────────────────────────────
echo "🔍  PR #${PR_NUM} — ${OWNER}/${REPO}"
echo "    model: ${MODEL}"
echo ""

PR_JSON=$(gh pr view "$PR_NUM" --repo "$GH_HOST_NAME/$OWNER/$REPO" \
	--json title,body,headRefName,headRefOid,baseRefName,author,additions,deletions,changedFiles 2>&1) ||
	{
		echo "Error fetching PR (check gh auth): $PR_JSON" >&2
		exit 1
	}

PR_TITLE=$(echo "$PR_JSON" | jq -r '.title')
PR_BODY=$(echo "$PR_JSON" | jq -r '.body // "(no description provided)"')
PR_AUTHOR=$(echo "$PR_JSON" | jq -r '.author.login')
BASE_BRANCH=$(echo "$PR_JSON" | jq -r '.baseRefName')
HEAD_BRANCH=$(echo "$PR_JSON" | jq -r '.headRefName // ""')
ADDITIONS=$(echo "$PR_JSON" | jq -r '.additions')
DELETIONS=$(echo "$PR_JSON" | jq -r '.deletions')
N_FILES=$(echo "$PR_JSON" | jq -r '.changedFiles')

echo "    ${PR_TITLE}"
echo "    @${PR_AUTHOR}  ·  +${ADDITIONS} -${DELETIONS}  ·  ${N_FILES} files changed"
echo ""

# ── loop check ─────────────────────────────────────────────────────────────────────
# Earlier gh-pr-review reviews by trusted authors are earlier rounds. Before any clone or model call, decide whether this
# round should run: not when nothing changed, and not when the loop has stopped converging (see `gh pr-review rounds`).
HEAD_OID=$(echo "$PR_JSON" | jq -r '.headRefOid // empty')
# Only trusted reviews are rounds: by an owner, member or collaborator of the repo, or by this account (ROUNDS_ME, the
# same login for the final re-read). The others are named once, here. Without this account's login its own rounds
# would be missed: the run stops here, before any clone or model call.
ME=$(operator_login "$GH_HOST_NAME") || exit 1
ROUNDS_ME="$ME"
IGNORED_FILE=$(mktemp)
RECORDS=$(fetch_round_records "$GH_HOST_NAME" "$OWNER" "$REPO" "$PR_NUM" "$ROUNDS_ME" "$IGNORED_FILE") || {
	rm -f "$IGNORED_FILE"
	exit 1
}
IGNORED_LINE=$(ignored_line "$(cat "$IGNORED_FILE")")
rm -f "$IGNORED_FILE"
[[ -z "$IGNORED_LINE" ]] || echo "    $IGNORED_LINE"
LIFTED=false
if [[ $(jq 'length' <<<"$RECORDS") -gt 0 ]]; then
	LIFTED=$(lifted_since "$GH_HOST_NAME" "$OWNER" "$REPO" "$PR_NUM" "$(jq -r 'last.posted_at // ""' <<<"$RECORDS")" "$PR_AUTHOR")
fi
PR_SHAPE=$(jq -cn --argjson lines "$((ADDITIONS + DELETIONS))" --argjson files "$N_FILES" '{lines: $lines, files: $files}')
LOOP=$(loop_decide_json "$RECORDS" "$PR_SHAPE" "$HEAD_OID" "$LIFTED" "{\"skip_approach\": $SKIP_APPROACH}")
LOOP_DECISION=$(jq -r '.decision' <<<"$LOOP")
ROUND=$(jq -r '.next_round' <<<"$LOOP")
PREVIOUS_RECORD=$(jq -c 'last // null' <<<"$RECORDS")
# The GitHub review ID of each round, in order: the history this round is reviewed on top of.
ROUND_IDS=$(jq -c 'map(.review_id)' <<<"$RECORDS")
# New findings are numbered after the highest ID anywhere in the history, so an ID never restarts.
ID_FLOOR=$(jq -c -L "$LIB_DIR" 'include "records"; id_floor' <<<"$RECORDS")

if [[ "$CHECK_ONLY" == "true" ]]; then
	if [[ "$CHECK_JSON" == "true" ]]; then echo "$LOOP" >&3; else loop_text "$LOOP"; fi
	[[ "$LOOP_DECISION" != stop ]] || loop_check_save "$LOOP"
	case "$LOOP_DECISION" in
	stop) exit 3 ;;
	nothing-new) exit 5 ;;
	*) exit 0 ;;
	esac
fi

FORCED=false
case "$LOOP_DECISION" in
nothing-new)
	if [[ "$FORCE_ROUND" == "true" ]]; then
		FORCED=true
		echo "    No new commits since round $((ROUND - 1)); running anyway (--force-round)."
	elif [[ -t 0 && "$YES" == "false" ]]; then
		# Someone may want a second opinion on the same commit: ask, as for a stop.
		echo "No new commits since round $((ROUND - 1)) (${HEAD_OID:0:7})."
		read -r -p "Run round ${ROUND} anyway? [y/N] " LOOP_ANSWER || LOOP_ANSWER=""
		[[ "$LOOP_ANSWER" == [Yy]* ]] || {
			echo "Nothing to review."
			exit 5
		}
		FORCED=true
	else
		echo "No new commits since round $((ROUND - 1)) (${HEAD_OID:0:7}): nothing to review. --force-round runs anyway."
		exit 5
	fi
	;;
stop)
	loop_text "$LOOP" >&2
	if [[ "$FORCE_ROUND" == "true" ]]; then
		FORCED=true
	elif [[ -t 0 && "$YES" == "false" ]]; then
		read -r -p "Run round ${ROUND} anyway? [y/N] " LOOP_ANSWER
		[[ "$LOOP_ANSWER" == [Yy]* ]] || {
			loop_check_save "$LOOP"
			echo "Stopped by the loop check."
			exit 3
		}
		FORCED=true
	else
		loop_check_save "$LOOP"
		echo "Stopped by the loop check (exit 3). --force-round runs anyway." >&2
		exit 3
	fi
	;;
warn)
	echo "    Loop: $(jq -r '.label + " (" + .reason + ")"' <<<"$LOOP")"
	;;
esac
# A loop that stopped converging says so at the top of the posted review.
LOOP_LINE=""
if jq -e '.label == "nit-loop" or .label == "churning"' <<<"$LOOP" >/dev/null; then
	LOOP_LINE=$(loop_line "$LOOP")
fi
echo "    round: ${ROUND}"
echo ""

# ── review checkout ──────────────────────────────────────────────────────────
# One run per PR at a time on this machine; the run works in <PR_STATE_DIR>/run-<time>, renamed when it ends.
pr_lock || exit 1
SESSION_DIR=$(run_dir_new) || exit 1
PROMPT_FILE="${SESSION_DIR}/prompt.md"
OWNER_PROMPT_FILE="${SESSION_DIR}/owner-prompt.md"
APPROACH_FILE="${SESSION_DIR}/approach.md"

# Per-command credential helper: the token never lands in a clone's .git/config. GIT_AUTH and DELTA_REMOTE are read
# by lib/clones.sh and lib/delta.sh.
# shellcheck disable=SC2034
GIT_AUTH=(-c credential.helper= -c "credential.helper=!gh auth git-credential")
CLONE_URL="https://${GH_HOST_NAME}/${OWNER}/${REPO}.git"
# A previous head that is missing is fetched by SHA from the PR's repository (lib/delta.sh), not from a remote name.
# shellcheck disable=SC2034
DELTA_REMOTE="$CLONE_URL"

# The review runs in REVIEW_DIR. CLONE_DIR is the repository it belongs to: a local clone (lib/clones.sh), whose PR
# refs are refs/pr-review/<N>/* and whose review worktree is <clone>.reviews/<branch>/<N> (lib/worktree.sh); or, with
# --fresh, a throwaway depth-50 clone in the run folder, which is also REVIEW_DIR. Nothing else in a local clone
# changes: its branches, remote-tracking refs, HEAD, index, stash, config and working tree stay as they are.
if [[ "$FRESH" == "true" ]]; then
	echo "⏳  Cloning ${OWNER}/${REPO}..."
	CLONE_DIR="${SESSION_DIR}/repo"
	fresh_checkout "$CLONE_DIR" "$CLONE_URL" "$PR_NUM" "$BASE_BRANCH" || exit 1
	REVIEW_DIR="$CLONE_DIR"
	echo "    clone: ${CLONE_DIR} (fresh)"
else
	find_clone "$GH_HOST_NAME" "$OWNER" "$REPO" || exit 1
	echo "    clone: ${CLONE_DIR} (${CLONE_KIND})"
	echo "⏳  Fetching PR #${PR_NUM} and ${BASE_BRANCH}..."
	fetch_pr "$CLONE_DIR" "$CLONE_URL" "$PR_NUM" "$BASE_BRANCH" || exit 1
	HEAD_SHA=$(rgit -C "$CLONE_DIR" rev-parse --verify --quiet "refs/pr-review/${PR_NUM}/head^{commit}") || exit 1
	review_worktree "$CLONE_DIR" "$PR_NUM" "$HEAD_BRANCH" "$HEAD_SHA" || exit 1
	REVIEW_DIR="$WORKTREE_DIR"
	echo "    worktree: ${REVIEW_DIR}"
fi

cd "$REVIEW_DIR"
HEAD_SHA=$(rgit rev-parse HEAD)
if ! BASE_SHA=$(review_base "$REVIEW_DIR" "$PR_NUM" 2>/dev/null); then
	# A local clone has its full history: no merge-base is final. The shallow --fresh clone deepens once first.
	[[ "$FRESH" == "true" ]] && fresh_deepen "$REVIEW_DIR" "$CLONE_URL" "$PR_NUM" "$BASE_BRANCH"
	BASE_SHA=$(review_base "$REVIEW_DIR" "$PR_NUM") || {
		echo "Error: no merge-base between the PR head and ${BASE_BRANCH}." >&2
		if [[ "$FRESH" == "true" ]]; then
			echo "Within the shallow clone (depth 50, deepened by 200). Refusing to review a partial diff." >&2
		fi
		exit 1
	}
fi

echo "    base: ${BASE_SHA:0:8}  head: ${HEAD_SHA:0:8}"
echo ""

CONTEXT_DIR="${SESSION_DIR}/context"
write_pr_context "$CONTEXT_DIR"

# ── previous round ─────────────────────────────────────────────────────────────────
# Round 2 and later build on the last round with a code review (a Rethink round has none): its open findings are
# re-checked by ID, and what changed since its head is reviewed in full. Anything unusable makes a full round, a
# record without its findings list included: the open findings it had cannot be re-checked, so nothing may be
# skipped. PREVIOUS_OPEN and PREVIOUS_FIXED count only a list that is there: the open findings to re-check, and the
# ones that round fixed, to catch a regression.
FINDINGS_BASE=$(jq -c '[.[] | select(.code_review != false)] | last // null' <<<"$RECORDS")
BASE_ROUND=$(jq -r '.round // empty' <<<"$FINDINGS_BASE")
FINDINGS_KNOWN=$(jq -L "$LIB_DIR" 'include "records"; has_findings_list' <<<"$FINDINGS_BASE")
previous_count() { # <jq status filter>
	jq -L "$LIB_DIR" "include \"records\"; if has_findings_list then [.findings[] | objects | select($1)] | length
		else 0 end" <<<"$FINDINGS_BASE"
}
PREVIOUS_OPEN=$(previous_count '.status == "open" or .status == "new" or .status == "regressed"')
PREVIOUS_FIXED=$(previous_count '.status == "fixed"')
if [[ "$FINDINGS_BASE" == null ]]; then
	if [[ "$PREVIOUS_RECORD" == null ]]; then DELTA_REASON="no previous round"; else DELTA_REASON="no earlier code review"; fi
	DELTA=$(jq -cn --arg reason "$DELTA_REASON" '{mode: "full", reason: $reason, commands: []}')
elif [[ "$FINDINGS_KNOWN" != true ]]; then
	# A later round read back from its Markdown (no marker) shows only what it re-checked: no list either.
	DELTA=$(jq -c '{mode: "full", commands: [], reason: (if .source == "backfill" then "the last round has no record of its findings"
		else "the last record lost its findings to the size cap" end)}' <<<"$FINDINGS_BASE")
elif [[ "$FULL_ROUND" == "true" ]]; then
	DELTA='{"mode":"full","reason":"--full","commands":[]}'
else
	# The previous head and base: refs/pr-review/<N>/round-<K> and …-base first (they survive a force-push), then the
	# record. A --fresh clone has no round refs. pick_delta fetches a missing one by SHA (a round posted before
	# review worktrees, or from another machine).
	PREV_SHAS=$(jq -r '.head_sha // "", .base_sha // ""' <<<"$FINDINGS_BASE")
	[[ "$FRESH" == "true" ]] || PREV_SHAS=$(round_shas "$REVIEW_DIR" "$PR_NUM" "$BASE_ROUND" \
		"$(sed -n 1p <<<"$PREV_SHAS")" "$(sed -n 2p <<<"$PREV_SHAS")")
	DELTA=$(pick_delta "$REVIEW_DIR" "$(sed -n 1p <<<"$PREV_SHAS")" "$(sed -n 2p <<<"$PREV_SHAS")" "$HEAD_SHA" "$BASE_SHA") ||
		DELTA='{"mode":"full","reason":"could not compare with the last round","commands":[]}'
fi
# delta-files.txt: the files the changes touched, for rule 3. A list git could not give is no proof that the other
# files are untouched: the round is full instead.
if DELTA_FILES=$(changed_files "$REVIEW_DIR" "$DELTA" 2>/dev/null); then
	[[ "$(jq -r '.mode' <<<"$DELTA")" == full ]] || printf '%s\n' "$DELTA_FILES" | sed '/^$/d' >"$CONTEXT_DIR/delta-files.txt"
else
	DELTA=$(jq -c '.mode = "full" | .reason = "could not list the files the changes touched" | .commands = []
		| del(.from)' <<<"$DELTA")
fi
ROUND_MODE=$(jq -r '.mode' <<<"$DELTA")
if [[ "$ROUND" -gt 1 ]]; then
	if [[ "$ROUND_MODE" == full ]]; then
		echo "    mode: full ($(jq -r '.reason' <<<"$DELTA"))"
	else
		echo "    mode: ${ROUND_MODE} since round ${BASE_ROUND} · ${PREVIOUS_OPEN} earlier findings to re-check," \
			"${PREVIOUS_FIXED} fixed to watch"
	fi
	echo ""
fi

# The n-th gh-pr-review review on the PR, without its marker lines.
round_body() { # <round>
	# The same tests as fetch_round_records (the header on the first line, a trusted author: trusted_review), so the
	# n-th body is round n. An outsider's generated review is no round, and never the previous review.
	jq -r -L "$LIB_DIR" --argjson n "$1" --arg me "${ROUNDS_ME:-}" 'include "records";
		[.reviews[] | select(.state != "PENDING" and (.body | is_generated_review)
			and ({author_association: .authorAssociation, user: {login: .author.login?}} | trusted_review($me)))]
		| sort_by(.submittedAt) | .[$n - 1].body // ""' "$CONTEXT_DIR/discussion.json" | grep -v '^<!-- gh-pr-review' || true
}

# previous-review.md and previous-findings.md: the last code review, its open findings and the ones it fixed, for
# rule 1. Written when either list has one: a fixed finding is listed so that, coming back, it keeps its ID and
# counts as regressed instead of looking new.
if [[ "$PREVIOUS_OPEN" -gt 0 || "$PREVIOUS_FIXED" -gt 0 ]]; then
	round_body "$BASE_ROUND" >"$CONTEXT_DIR/previous-review.md"
	# A detail the last marker left out (its review did not show it) comes back from an earlier round, by ID.
	finding_lines() { # <jq status filter>
		jq -r -L "$LIB_DIR" --argjson base "$FINDINGS_BASE" "include \"records\"; . as \$history | \$base
			| recover_details(\$history) | .findings[] | objects | select($1)
			| [.id, .severity, ((.file // \"(no file)\") + (if .line then \":\\(.line)\" else \"\" end)), (.title // \"\")]
			| join(\" · \")" <<<"$RECORDS"
	}
	{
		if [[ "$PREVIOUS_OPEN" -gt 0 ]]; then
			finding_lines '.status == "open" or .status == "new" or .status == "regressed"'
		fi
		if [[ "$PREVIOUS_FIXED" -gt 0 ]]; then
			[[ "$PREVIOUS_OPEN" == 0 ]] || echo
			printf 'Fixed in round %s (report one only if the problem is back, as open):\n' "$BASE_ROUND"
			finding_lines '.status == "fixed"'
		fi
	} >"$CONTEXT_DIR/previous-findings.md"
fi

# previous-approach.md: the last round's Approach section, carried forward unless it was a Rethink (judge afresh).
PREVIOUS_APPROACH_ROUND=""
if [[ "$SKIP_APPROACH" == "false" ]] &&
	jq -e '.approach == "sound" or .approach == "questionable"' <<<"$PREVIOUS_RECORD" >/dev/null 2>&1; then
	PREVIOUS_APPROACH_ROUND=$(jq -r '.round' <<<"$PREVIOUS_RECORD")
	round_body "$PREVIOUS_APPROACH_ROUND" |
		awk '/^###[[:space:]]+Approach/ { on = 1; print; next } on && /^###[[:space:]]/ { exit } on' \
			>"$CONTEXT_DIR/previous-approach.md"
	[[ -s "$CONTEXT_DIR/previous-approach.md" ]] || PREVIOUS_APPROACH_ROUND=""
fi

# ── build owner (approach) prompt ───────────────────────────────────────────────────────────
# Round 2 and later: the owner starts from its previous verdict and what changed since.
# shellcheck disable=SC2016 # Markdown backticks in printf formats, not command substitutions
previous_verdict_section() {
	[[ -n "$PREVIOUS_APPROACH_ROUND" ]] || return 0
	printf '## Your previous verdict (round %s)\n\n' "$PREVIOUS_APPROACH_ROUND"
	printf 'You judged this PR in round %s: read %s/previous-approach.md. ' "$PREVIOUS_APPROACH_ROUND" "$CONTEXT_DIR"
	if [[ "$ROUND_MODE" == full ]]; then
		printf 'What changed since: compare with `git diff --stat %s..%s` (the whole PR).\n\n' "$BASE_SHA" "$HEAD_SHA"
	else
		printf 'What changed since:\n\n```bash\n%s\n```\n\n' "$(jq -r '.commands[0]' <<<"$DELTA")"
	fi
	printf 'Also read %s/pr-discussion.md for what was said since round %s.\n\n' "$CONTEXT_DIR" "$PREVIOUS_APPROACH_ROUND"
	cat <<'VERDICT'
Keep the verdict unless what changed, or the discussion since, changes it. If nothing changes it, skip the steps
below and reply only this, filled in:

### Approach

VERDICT
	printf 'Unchanged since round %s: <one sentence: why it still holds>.\n\n' "$PREVIOUS_APPROACH_ROUND"
	cat <<'VERDICT'
**Approach:** <the same verdict>

Otherwise, follow the steps below and write the full section.

VERDICT
}

