			+ {counts: {open_blocking: null, critical: null, important: null, minor: null}}' \
			>"$FALLBACK_RECORD" 2>/dev/null || FALLBACK_RECORD=""
	fi
fi

# Round 2 and later open with a progress line, counted from the record. It replaces the loop line, and carries the
# loop's suggested move when the loop is not converging.
assemble_body() {
	local head_lines="$LOOP_LINE" progress suggestion
	if [[ -n "$RECORD_FILE" && -n "$THIS_LOOP" ]]; then
		progress=$(progress_line "$(cat "$RECORD_FILE")" "$FINDINGS_BASE" "$THIS_LOOP" 2>/dev/null || true)
		if [[ -n "$progress" ]]; then
			head_lines="$progress"
			suggestion=$(jq -r 'if (.labels[-1] == "nit-loop" or .labels[-1] == "churning") then .suggestion // "" else "" end' \
				<<<"$THIS_LOOP")
			[[ -z "$suggestion" ]] || head_lines+=$'\n'"**Next:** ${suggestion}"
		fi
	fi
	REVIEW_HEAD=$head_lines
	REVIEW=$(assemble_review "$head_lines" "$APPROACH" "$CODE_REVIEW")
}
assemble_body

