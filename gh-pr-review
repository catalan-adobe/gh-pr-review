# Round 2 and later. Rule 1 (re-check the earlier findings) needs open or fixed findings from the last code review;
# rules 2 and 3 (review what changed in full, only Critical outside it) need an incremental or rebased delta.
later_round() { [[ "$PREVIOUS_OPEN" -gt 0 || "$PREVIOUS_FIXED" -gt 0 || "$ROUND_MODE" != full ]]; }

# shellcheck disable=SC2016 # Markdown backticks in printf formats, not command substitutions
previous_round_section() {
	later_round || return 0
	local n=0
	printf '## Previous round\n\n'
	printf 'This is round %s. Round %s was the last code review of this PR.' "$ROUND" "$BASE_ROUND"
	if [[ "$ROUND_MODE" == full ]]; then
		printf ' This round is a full review (%s): review the whole PR as usual.' "$(jq -r '.reason' <<<"$DELTA")"
	fi
	printf '\n\n'
	if [[ "$PREVIOUS_OPEN" -gt 0 ]]; then
		n=$((n + 1))
		printf '%s. **Check every earlier finding.** Read %s/previous-findings.md: one line per finding still open ' \
			"$n" "$CONTEXT_DIR"
		printf 'after round %s (ID · severity · file:line · title). Their full text is in %s/previous-review.md. ' \
			"$BASE_ROUND" "$CONTEXT_DIR"
		cat <<'RULE1'
Check each one against the current code and give it a status:
   - `fixed`: the current code no longer has the problem.
   - `open`: it is still there. A fix attempt that did not work stays open: say what is still wrong.
   - `declined`: only when the PR discussion gives a reason you accept. Quote it, in `"reason"`: a decline without
     one stays open.

   Every open ID listed is mandatory: it appears once in the findings block, with its status. Never invent IDs.
RULE1
		if [[ "$PREVIOUS_FIXED" -gt 0 ]]; then
			printf '   The file then lists the findings fixed in round %s. Those are not mandatory: report one only if ' \
				"$BASE_ROUND"
			printf 'the problem is back, with its ID, as `open`.\n'
		fi
		printf '\n'
	elif [[ "$PREVIOUS_FIXED" -gt 0 ]]; then
		n=$((n + 1))
		printf '%s. **Check whether an earlier finding came back.** Round %s fixed the findings listed in ' \
			"$n" "$BASE_ROUND"
		printf '%s/previous-findings.md (ID · severity · file:line · title), and left none open. Its review is in ' \
			"$CONTEXT_DIR"
		printf '%s/previous-review.md. If the current code has one of these problems again, report it with its ID, ' \
			"$CONTEXT_DIR"
		printf 'as `open`. Leave out the ones that are still fixed. Never invent IDs.\n\n'
	fi
	if [[ "$ROUND_MODE" != full ]]; then
		n=$((n + 1))
		if [[ "$ROUND_MODE" == rebased ]]; then
			printf '%s. **Review what changed since round %s in full, at every severity.** The author rebased since ' \
				"$n" "$BASE_ROUND"
