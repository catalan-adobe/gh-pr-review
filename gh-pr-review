# ── record ─────────────────────────────────────────────────────────────────────────
# round.json starts as a preview; the post block turns it into the posted round. A failure here never blocks the post.
# Statuses build on the last code review (FINDINGS_BASE); THIS_LOOP is the loop decision with this round included.
# It runs under `if !`, where errexit is off: every step checks its own status, and the record is checked before use.
THIS_LOOP=""
write_round_record() {
	local findings parsed source=model code_review=true unknown_counts=false approach ready meta history delta_files
	local tmp="${RECORD_FILE}.tmp"
	# The files the delta touched (null in a full round): the record builder and the block checks decide Later with them.
	delta_files=$(jq -cn --argjson delta "$DELTA" --arg files "$DELTA_FILES" \
		'if $delta.mode == "full" then null else $files | split("\n") | map(select(. != "")) end') || return 1
	if [[ "$APPROACH_VERDICT" == rethink ]]; then
		code_review=false
		findings='[]'
	else
		# The Markdown is the code review alone (review-body.md), never the approach or the footer: the reader of the
		# posted review reads the same text, after its boundary line (code_review_part in lib/records.jq).
		# The Markdown's findings: the check that the block shows every blocker the review does, and the source when
		# the block is rejected.
		# A parse failure leaves a parsed record without findings, as the spec says: it never blocks the post.
		parsed="${RECORD_FILE}.parsed"
		parse_findings "$REVIEW_BODY_FILE" >"$parsed" 2>/dev/null || echo '[]' >"$parsed"
		# Status-only entries are allowed for the last code review's IDs only. The block must hold exactly one JSON
		# value, an array: anything else ("[] [ … ]") is read from the Markdown. So is a block with an open finding of a
		# severity the Markdown says it has none of ("*(none found)*"). Its entries are checked as the record will store
		# them (stored_findings, the builder's own decision): a declined one without a reason, or a Later one that is not
		# honoured, is open; one stored as fixed, declined or Later is not. A Later one that is not honoured (promoted)
		# and that the Markdown shows in its Later list is no contradiction: the block keeps it as a finding.
		if jq -se -L "$LIB_DIR" --slurpfile parsed "$parsed" --rawfile md "$REVIEW_BODY_FILE" \
			--argjson base "$FINDINGS_BASE" --argjson delta "$DELTA" --argjson files "$delta_files" \
			'include "records"; length == 1 and (.[0] | findings_block_ok($base | known_ids)
				and (later_files($delta.mode; $files) as $later | block_covers_markdown($parsed[0]; $base; $later)
					and block_respects_empty($md | empty_severities; $md | later_items; $base; $later)))' \
			"$FINDINGS_FILE" >/dev/null 2>&1; then
			findings=$(jq -cs '.[0]' "$FINDINGS_FILE") || return 1
		else
			if [[ -s "$FINDINGS_FILE" ]]; then
				echo "Note: the findings block does not match the review's findings; the record is read from the Markdown." >&2
			fi
			source=parsed
			findings=$(jq -c . "$parsed") || findings='[]'
			# No severity section in the Markdown: the blockers are unknown (null counts), as when read back. So are they
			# when the rejected block promoted a Later entry to a finding: the parser leaves the Later list out, so the
			# Markdown's count would miss it.
			unknown_counts=$(jq -Rs -L "$LIB_DIR" 'include "records"; _sections | length == 0' "$REVIEW_BODY_FILE") ||
				unknown_counts=true
			if [[ "$unknown_counts" != true ]] && jq -se -L "$LIB_DIR" --argjson base "$FINDINGS_BASE" \
				--argjson delta "$DELTA" --argjson files "$delta_files" \
				'include "records"; length == 1 and (.[0] | block_promotes($base; later_files($delta.mode; $files)))' \
				"$FINDINGS_FILE" >/dev/null 2>&1; then
				unknown_counts=true
			fi
		fi
		rm -f "$parsed"
	fi
	case "$APPROACH_VERDICT" in
	sound | questionable | rethink) approach="$APPROACH_VERDICT" ;;
	*) if [[ "$SKIP_APPROACH" == "true" ]]; then approach=skipped; else approach=unknown; fi ;;
	esac
	ready=$(normalize_ready "$(last_verdict 'ready to merge' "$CODE_REVIEW")") || return 1
	meta=$(jq -n --arg source "$source" --arg host "$GH_HOST_NAME" --arg owner "$OWNER" --arg repo "$REPO" \
		--argjson number "$PR_NUM" --argjson round "$ROUND" --arg reviewer "$ME" --arg model "$MODEL" \
		--arg base "$BASE_SHA" --arg head "$HEAD_SHA" --argjson previous "$PREVIOUS_RECORD" \
		--argjson findings_base "$FINDINGS_BASE" --argjson delta "$DELTA" \
		--arg approach "$approach" --arg ready "$ready" --argjson code_review "$code_review" \
		--argjson id_floor "$ID_FLOOR" --argjson delta_files "$delta_files" --argjson unknown_counts "$unknown_counts" \
		'{source: $source, pr: {host: $host, owner: $owner, repo: $repo, number: $number}, round: $round,
		  mode: $delta.mode, mode_reason: ($delta.reason // null), delta_files: $delta_files,
		  reviewer: (if $reviewer == "" then null else $reviewer end), model: $model,
		  base_sha: $base, head_sha: $head,
		  previous_head_sha: ($findings_base.head_sha? // $previous.head_sha? // null),
		  approach: $approach, ready: $ready, decision: null, posted_at: null,
		  code_review: $code_review, preview: true, id_floor: $id_floor, unknown_counts: $unknown_counts}') || return 1
	if ! build_record "$meta" "$findings" "$FINDINGS_BASE" >"$tmp" ||
		! jq -e 'type == "object" and (.round | type == "number") and (.counts | type == "object")' \
			"$tmp" >/dev/null 2>&1; then
		echo "Warning: the round record came out malformed." >&2
		rm -f "$tmp"
		return 1
	fi
	if ! history=$(jq -c --slurpfile r "$tmp" '. + $r' <<<"$RECORDS") ||
		! THIS_LOOP=$(loop_decide_json "$history" "$PR_SHAPE" "" false) ||
		! jq --argjson loop "$LOOP" --argjson this "$THIS_LOOP" --argjson forced "$FORCED" \
			'.loop = {label: $this.labels[-1], flags: $this.flags, decision: $loop.decision} | .forced = $forced' \
			"$tmp" >"$RECORD_FILE"; then
		THIS_LOOP=""
		rm -f "$tmp"
		return 1
	fi
	rm -f "$tmp"
}
# Without a record, round 2 and later still post a minimal marker (FALLBACK_RECORD): this is a later round, its
# findings list is missing and its blocker count unknown (null), with the history's last IDs. Its Markdown may leave
# out the blockers it carried, and a reader would otherwise take it for a first review: the next round then builds on
# an empty baseline. Read back, the round has null counts and no findings list (marker_counts_unknown), so the next
# round is full.
FALLBACK_RECORD=""
if ! write_round_record; then
	echo "Warning: could not write the round record; the review is posted without it." >&2
	RECORD_FILE=""
	if [[ "$ROUND" -gt 1 ]]; then
