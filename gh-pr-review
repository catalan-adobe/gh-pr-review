echo ""

# ── post ─────────────────────────────────────────────────────────────────────
# The PR's round records now, read again just before posting (one retry). Fails when GitHub can't say.
rounds_now() {
	local try
	for try in 1 2; do
		fetch_round_records "$GH_HOST_NAME" "$OWNER" "$REPO" "$PR_NUM" "${ROUNDS_ME:-}" 2>/dev/null && return 0
		[[ "$try" == 2 ]] || sleep 1
	done
	return 1
}

# The PR's head commit now, read again just before posting (one retry). Fails when GitHub can't say.
pr_head_now() {
	local json try
	for try in 1 2; do
		if json=$(gh pr view "$PR_NUM" --repo "$GH_HOST_NAME/$OWNER/$REPO" --json headRefOid 2>/dev/null) &&
			jq -er '.headRefOid | strings | select(. != "")' <<<"$json" 2>/dev/null; then
			return 0
		fi
		[[ "$try" == 2 ]] || sleep 1
	done
	return 1
}

# After the post request failed: true when the review is on the PR all the same (the request reached GitHub, the
# answer did not come back). That is exactly one review that was not a round at the final re-read (its ID is not in
# NOW_IDS), by this user, on the reviewed commit, in the state the event gives, with the body post.json sent (CRLF
# and trailing whitespace aside). Another review by the same account on the same commit is not this one. One read;
# anything in doubt (no login, a failed read, no match or several) is false.
review_landed() {
	local json
	[[ -n "${ME:-}" ]] || return 1
	json=$(gh api --hostname "$GH_HOST_NAME" --paginate "repos/$OWNER/$REPO/pulls/$PR_NUM/reviews" 2>/dev/null) ||
		return 1
	jq -se --arg me "$ME" --arg commit "$HEAD_SHA" --argjson before "${NOW_IDS:-null}" \
		--slurpfile post "${SESSION_DIR}/post.json" '
		def norm: gsub("\r\n"; "\n") | gsub("[ \t]+\n"; "\n") | sub("\\s+$"; "");
		($post[0].body | norm) as $body
		| ({APPROVE: "APPROVED", REQUEST_CHANGES: "CHANGES_REQUESTED", COMMENT: "COMMENTED"}[$post[0].event]) as $state
		| [add // [] | .[] | select(.id as $id | ($id | type == "number") and all($before[]; . != $id))
			| select(.user.login == $me and .commit_id == $commit and .state == $state
				and (.body | type == "string") and (.body | norm) == $body)]
		| length == 1' <<<"$json" >/dev/null 2>&1
}

# True only when a successful read of the record file shows that its round has no open blocker: counts.open_blocking
# is the number 0. A nonzero count, an unknown one (a code review read from its Markdown without a severity section),
# a missing file or a failed read is false: an automatic approve needs this to succeed.
no_blockers() { # <record-file>
	jq -e '(.counts.open_blocking | type) == "number" and .counts.open_blocking == 0' "$1" >/dev/null 2>&1
}

# Why an automatic approve became a comment, after no_blockers failed on the record file: its open blockers when it
# shows a number other than 0, else an unknown count (as when the check itself failed).
blockers_note() { # <record-file>
	local n
	if n=$(jq -er '.counts.open_blocking | numbers | select(. != 0)' "$1" 2>/dev/null); then
		echo "But ${n} blocking findings are still open: posting as comment, not approve."
	else
		echo "The review's blockers are unknown: posting as comment, not approve."
	fi
}

# The final record: round.json as posted, with DECISION, built and checked here. Only a record that passes is
# posted: a preview that went missing, empty or invalid since it was written is no record.
posted_record() {
	POSTED_RECORD=""
	[[ -n "${RECORD_FILE:-}" ]] || return 0
	if [[ -s "$RECORD_FILE" ]] &&
		jq --arg decision "$DECISION" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
			'.decision = $decision | .posted_at = $at | .preview = false' "$RECORD_FILE" >"$RECORD_FILE.posted" 2>/dev/null &&
		jq -e 'type == "object" and (.round | type == "number") and (.counts | type == "object")' \
			"$RECORD_FILE.posted" >/dev/null 2>&1; then
		POSTED_RECORD="$RECORD_FILE.posted"
	else
		echo "Warning: could not write the posted round record; the review is posted without it." >&2
		rm -f "$RECORD_FILE.posted"
	fi
}

POSTED=false
if [[ "$POST_TO_PR" == "true" ]] && [[ -n "$REVIEW" ]]; then
	if [[ -z "$DECISION" && "${APPROACH_VERDICT:-}" == rethink ]]; then
		DECISION=request-changes
		echo "Approach: rethink → ${DECISION}"
	fi
	AUTO_DECISION=false
	if [[ -z "$DECISION" ]]; then
		AUTO_DECISION=true
		VERDICT=$(last_verdict 'ready to merge' "$CODE_REVIEW")
		# Only a bare "yes" approves; any qualifier ("yes, with fixes") falls through to comment.
		case "$VERDICT" in
		yes) DECISION=approve ;;
		no | "no "* | no[,\;\(—–-]*) DECISION=request-changes ;;
		*) DECISION=comment ;;
		esac
		echo "Verdict: ${VERDICT:-not found} → ${DECISION}"
		# The record wins over a "Yes" while blocking findings are still open.
		if [[ "$DECISION" == approve && -n "${RECORD_FILE:-}" ]] &&
			jq -e '.ready_overridden == true' "$RECORD_FILE" >/dev/null 2>&1; then
			DECISION=comment
			echo "    but $(jq -r '.counts.open_blocking' "$RECORD_FILE") blocking findings are still open → ${DECISION}"
		# An approval says the findings were checked; without a record nothing can show that, so only comment. Nor
		# can a record that does not show a blocker count of 0 (no_blockers), whatever the lookup above said.
		elif [[ "$DECISION" == approve && -z "${RECORD_FILE:-}" ]]; then
			DECISION=comment
			echo "No round record for this review: posting as comment, not approve."
		elif [[ "$DECISION" == approve ]] && ! no_blockers "$RECORD_FILE"; then
			DECISION=comment
			blockers_note "$RECORD_FILE"
		fi
	fi

	if [[ "$YES" == "false" ]]; then
		read -r -p "Post as review [c]omment, [a]pprove, [r]equest changes, or [N]o? (Enter = ${DECISION}) " confirm
		case "$confirm" in
		"") ;;
		[Cc]*) DECISION=comment AUTO_DECISION=false ;;
		[Aa]*) DECISION=approve AUTO_DECISION=false ;;
		[Rr]*) DECISION=request-changes AUTO_DECISION=false ;;
		*)
			echo "Aborted — review not posted."
			exit 0
			;;
		esac
	fi

	ME=${ME:-$(gh api --hostname "$GH_HOST_NAME" user --jq .login 2>/dev/null || true)}
	if [[ "$DECISION" != "comment" && "$ME" == "$PR_AUTHOR" ]]; then
		echo "Note: GitHub blocks ${DECISION} on your own PR; posting as comment."
		DECISION=comment
	fi

	# A round posted by someone else while this one ran: this one was reviewed without it, so it is never posted on top
	# of it. Read the history again first; when that read fails twice, nothing is posted either.
	if ! NOW_RECORDS=$(rounds_now); then
		echo "Error: could not read the PR's rounds again, so the history could not be verified; nothing was posted." >&2
		echo "    Session: ${SESSION_DIR}" >&2
		exit 1
	fi
	# The same rounds, by GitHub review ID and in order: a new round, a round gone or one that is no longer a round (its
	# generated header edited out) all mean this review was not made on top of the history as it is now.
	NOW_IDS=$(jq -c 'map(.review_id)' <<<"$NOW_RECORDS")
	if [[ "$NOW_IDS" != "$ROUND_IDS" ]]; then
		NEW_ROUNDS=$(jq -r --argjson old "$ROUND_IDS" 'to_entries[]
			| select(.value.review_id as $id | if $id == null then .key >= ($old | length) else all($old[]; . != $id) end)
			| .value | "    round \(.round) by \(.reviewer // "unknown") at \(.posted_at // "an unknown time")"' <<<"$NOW_RECORDS")
		if [[ -n "$NEW_ROUNDS" ]]; then
			echo "Not posted (exit 6): another round was posted while this review ran ($((ROUND - 1)) rounds then, $(jq length <<<"$NOW_RECORDS") now):" >&2
			printf '%s\n' "$NEW_ROUNDS" >&2
		else
			echo "Not posted (exit 6): the PR's rounds changed while this review ran (a round was removed or is no longer one)." >&2
		fi
		echo "    Run the review again to review on top of them. Session: ${SESSION_DIR}" >&2
		exit 6
	fi

	# The review covers HEAD_SHA and is posted on it (commit_id). A push while it ran is not reviewed: never approve it.
	HEAD_NOTE=""
	if ! NOW_HEAD=$(pr_head_now); then
		echo "Could not read the PR's head before posting; this review covers ${HEAD_SHA:0:7}."
		HEAD_NOTE=unknown
	elif [[ "$NOW_HEAD" != "$HEAD_SHA" ]]; then
		HEAD_NOTE="The PR moved to ${NOW_HEAD:0:7} during the review; this review covers ${HEAD_SHA:0:7}."
		echo "$HEAD_NOTE"
		# Right after the review's head (the progress lines, or the loop line) when there is one: it stays first.
		if [[ -n "${REVIEW_HEAD:-}" && "$REVIEW" == "$REVIEW_HEAD"$'\n\n'* ]]; then
			REVIEW=$(printf '%s\n\n**Note:** %s\n\n%s' "$REVIEW_HEAD" "$HEAD_NOTE" "${REVIEW:${#REVIEW_HEAD}+2}")
		else
			REVIEW=$(printf '**Note:** %s\n\n%s' "$HEAD_NOTE" "$REVIEW")
		fi
	fi
	if [[ -n "$HEAD_NOTE" && "$DECISION" == approve ]]; then
		DECISION=comment
		echo "Posting as comment, not approve: an approval must cover the PR's head."
	fi

	posted_record
	# Right before posting: an automatic approve (the verdict's, or its default taken at the prompt) needs a posted
	# record that shows a blocker count of 0 (no_blockers); otherwise it posts as comment, and the record is built
	# again with that decision, so the event, the marker and round.json all say comment. An approve someone chose
	# stays.
	if [[ "$DECISION" == approve && "$AUTO_DECISION" == true ]]; then
		if [[ -z "$POSTED_RECORD" ]]; then
			DECISION=comment
			echo "No round record for this review: posting as comment, not approve."
		elif ! no_blockers "$POSTED_RECORD"; then
			DECISION=comment
			blockers_note "$POSTED_RECORD"
			posted_record
		fi
	fi

	MARKER=""
	if [[ -n "$POSTED_RECORD" ]]; then
		# The marker is sized for the exact body below: header, newline, marker, newline, review.
		if ! MARKER=$(marker_line "$POSTED_RECORD" "$REVIEW"); then
			MARKER=""
			echo "Warning: could not write the round marker; posting the review without it." >&2
		elif [[ -z "$MARKER" ]]; then
			echo "Warning: the review leaves no room for its round marker; posting it without one." >&2
			echo "    round.json keeps the full record: ${RECORD_FILE}" >&2
		fi
		[[ -z "$MARKER" ]] || MARKER+=$'\n'
	elif [[ -n "${FALLBACK_RECORD:-}" ]]; then
		MARKER=$(marker_line "$FALLBACK_RECORD" "$REVIEW" 2>/dev/null) || MARKER=""
		[[ -z "$MARKER" ]] || MARKER+=$'\n'
	fi
	COMMENT=$(printf '<!-- gh-pr-review generated -->\n%s%s' "$MARKER" "$REVIEW")

	case "$DECISION" in
	approve) EVENT=APPROVE ;;
	request-changes) EVENT=REQUEST_CHANGES ;;
	*) EVENT=COMMENT ;;
	esac
	# Bound to the reviewed commit, so a push while the review ran is still unreviewed. The body goes through a file.
	printf '%s' "$COMMENT" | jq -Rs --arg commit "$HEAD_SHA" --arg event "$EVENT" \
		'{commit_id: $commit, event: $event, body: .}' >"${SESSION_DIR}/post.json"
	if ! gh api --hostname "$GH_HOST_NAME" --method POST "repos/$OWNER/$REPO/pulls/$PR_NUM/reviews" \
		--input "${SESSION_DIR}/post.json" >/dev/null; then
		# An error does not always mean nothing was posted: the answer can be lost after GitHub took the review.
		if review_landed; then
			echo "Warning: GitHub answered with an error, but the review is on the PR: it was posted." >&2
		else
			echo "Error: could not confirm whether the review was posted; run" \
				"\`gh pr-review rounds https://${GH_HOST_NAME}/${OWNER}/${REPO}/pull/${PR_NUM}\` before retrying." >&2
			echo "    Session: ${SESSION_DIR}" >&2
			exit 1
		fi
	fi
	if [[ -n "$POSTED_RECORD" ]]; then
		mv "$POSTED_RECORD" "$RECORD_FILE"
	fi
	printf '%s\n' "$COMMENT" >"${SESSION_DIR}/posted.md"
	echo "✓  Posted → https://${GH_HOST_NAME}/${OWNER}/${REPO}/pull/${PR_NUM}"
	POSTED=true
fi

# ── run folder ───────────────────────────────────────────────────────────────
# Its final name: round-<K> after a post, K the posted record's round; preview-<time> for --no-post. Any other run
# keeps run-<time>.
cd "$PR_STATE_DIR"
if [[ "$POSTED" == true ]]; then
	K=$(jq -er '.round | numbers' "${RECORD_FILE:-}" 2>/dev/null) || K=$ROUND
	# The reviewed commits, kept in the clone as round K: the next round compares with them after a force-push too.
	if [[ "$FRESH" == false ]] && ! mark_round "$CLONE_DIR" "$PR_NUM" "$K" "$HEAD_SHA" "$BASE_SHA"; then
		echo "Warning: could not set refs/pr-review/${PR_NUM}/round-${K} in ${CLONE_DIR}" >&2
	fi
	SESSION_DIR=$(run_dir_finish "$SESSION_DIR" "$K")
elif [[ "$POST_TO_PR" == false ]]; then
	SESSION_DIR=$(run_dir_finish "$SESSION_DIR" preview)
fi
echo "    Session: ${SESSION_DIR}"
