# ── run pi ───────────────────────────────────────────────────────────────────
REVIEW_FILE="${SESSION_DIR}/review.md"
REVIEW_BODY_FILE="${SESSION_DIR}/review-body.md"
FINDINGS_FILE="${SESSION_DIR}/findings.json"
RECORD_FILE="${SESSION_DIR}/round.json"

echo "    session: ${SESSION_DIR}"
echo ""

cd "$REVIEW_DIR"

PI_ARGS=(
	--print
	--model "$MODEL"
	--no-context-files
	--no-skills
	--no-extensions
	--approve
	--thinking high
	--name "pr-review #${PR_NUM} ${OWNER}/${REPO}"
)

# Optional: load one pi extension during the review (e.g. session archival).
if [[ -n "${GH_PR_REVIEW_PI_EXTENSION:-}" && -f "$GH_PR_REVIEW_PI_EXTENSION" ]]; then
	PI_ARGS+=(--extension "$GH_PR_REVIEW_PI_EXTENSION")
fi

APPROACH=""
APPROACH_VERDICT=""
if [[ "$SKIP_APPROACH" == "false" ]]; then
	build_owner_prompt
	echo "⏳  Owner pass: judging the approach (this may take a few minutes)..."
	run_pi "$OWNER_PROMPT_FILE" "$APPROACH_FILE"
	APPROACH=$(cat "$APPROACH_FILE")
	# The first word decides ("rethink — because …" is a rethink); anything else is treated as no verdict.
	APPROACH_VERDICT=$(last_verdict 'approach' "$APPROACH")
	APPROACH_VERDICT=${APPROACH_VERDICT%%[^a-z]*}
	echo "    Approach: ${APPROACH_VERDICT:-not found}"
	echo ""
fi

CODE_REVIEW=""
if [[ "$APPROACH_VERDICT" == rethink ]]; then
	echo "    Rethink: skipping the code review."
	echo ""
else
	build_prompt
	echo "⏳  Running code review (this may take a few minutes)..."
	echo ""
	run_pi "$PROMPT_FILE" "$REVIEW_FILE"
	# The findings block is for the record only: the posted review is the reply without it.
	cut_findings_block "$REVIEW_FILE" "$REVIEW_BODY_FILE" "$FINDINGS_FILE"
	CODE_REVIEW=$(cat "$REVIEW_BODY_FILE")
	# Only a Rethink may post the approach alone; an empty code review is a failed run.
	if [[ -z "${CODE_REVIEW//[[:space:]]/}" ]]; then
		echo "Error: the code review came back empty — pi may have failed or timed out." >&2
		echo "    Nothing was posted. Session: ${SESSION_DIR}" >&2
		echo "    Try another model: --model github-copilot/gpt-5.5" >&2
		exit 1
	fi
fi

REVIEW=$(assemble_review "$LOOP_LINE" "$APPROACH" "$CODE_REVIEW")

# ── record ─────────────────────────────────────────────────────────────────────────
# round.json starts as a preview; the post block turns it into the posted round. A failure here never blocks the post.
# It runs under `if !`, where errexit is off: every step checks its own status, and the record is checked before use.
write_round_record() {
	local findings parsed source=model code_review=true approach ready meta tmp="${RECORD_FILE}.tmp"
	if [[ "$APPROACH_VERDICT" == rethink ]]; then
		code_review=false
		findings='[]'
	else
		# The Markdown's findings: the fallback, and the check that the block shows every blocker the review does.
		# A parse failure leaves a parsed record without findings, as the spec says: it never blocks the post.
		parsed="${RECORD_FILE}.parsed"
		parse_findings "$REVIEW_BODY_FILE" >"$parsed" 2>/dev/null || echo '[]' >"$parsed"
		if jq -e -L "$LIB_DIR" --slurpfile parsed "$parsed" \
			'include "records"; findings_block_ok and block_covers_markdown($parsed[0])' "$FINDINGS_FILE" >/dev/null 2>&1; then
			findings=$(jq -c . "$FINDINGS_FILE") || return 1
		else
			if [[ -s "$FINDINGS_FILE" ]]; then
				echo "Note: the findings block does not match the review's findings; the record is read from the Markdown." >&2
			fi
			source=parsed
			findings=$(jq -c . "$parsed") || findings='[]'
		fi
		rm -f "$parsed"
	fi
	case "$APPROACH_VERDICT" in
	sound | questionable | rethink) approach="$APPROACH_VERDICT" ;;
	*) if [[ "$SKIP_APPROACH" == "true" ]]; then approach=skipped; else approach=unknown; fi ;;
	esac
	ready=$(normalize_ready "$(last_verdict 'ready to merge' "$CODE_REVIEW")") || return 1
	meta=$(jq -n --arg source "$source" --arg host "$GH_HOST_NAME" --arg owner "$OWNER" --arg repo "$REPO" \
		--argjson number "$PR_NUM" --argjson round "$ROUND" --arg reviewer "$ME" --arg model "$MODEL" \
		--arg base "$BASE_SHA" --arg head "$HEAD_SHA" --argjson previous "$PREVIOUS_RECORD" \
		--arg approach "$approach" --arg ready "$ready" --argjson code_review "$code_review" \
		--argjson id_floor "$ID_FLOOR" \
		'{source: $source, pr: {host: $host, owner: $owner, repo: $repo, number: $number}, round: $round,
		  mode: "full", reviewer: (if $reviewer == "" then null else $reviewer end), model: $model,
		  base_sha: $base, head_sha: $head, previous_head_sha: ($previous.head_sha? // null),
		  approach: $approach, ready: $ready, decision: null, posted_at: null,
		  code_review: $code_review, preview: true, id_floor: $id_floor}') || return 1
	if ! build_record "$meta" "$findings" "$PREVIOUS_RECORD" |
		jq --argjson loop "$LOOP" --argjson forced "$FORCED" \
			'.loop = ($loop | {label, flags, decision}) | .forced = $forced' >"$tmp"; then
		rm -f "$tmp"
		return 1
	fi
	if ! jq -e 'type == "object" and (.round | type == "number") and (.counts | type == "object")' \
		"$tmp" >/dev/null 2>&1; then
		echo "Warning: the round record came out malformed." >&2
		rm -f "$tmp"
		return 1
	fi
	mv "$tmp" "$RECORD_FILE"
}
ME=$(gh api --hostname "$GH_HOST_NAME" user --jq .login 2>/dev/null || true)
if ! write_round_record; then
	echo "Warning: could not write the round record; the review is posted without it." >&2
	RECORD_FILE=""
fi

# ── display ──────────────────────────────────────────────────────────────────
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [[ -n "$REVIEW" ]]; then
	echo "$REVIEW"
else
	echo "⚠️  Review is empty — pi may have failed or timed out."
	echo "    Try running with a different model: --model github-copilot/gpt-5.5"
fi
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# ── post ─────────────────────────────────────────────────────────────────────
# The PR's round records now, read again just before posting (one retry). Fails when GitHub can't say.
rounds_now() {
	local try
	for try in 1 2; do
		fetch_round_records "$GH_HOST_NAME" "$OWNER" "$REPO" "$PR_NUM" 2>/dev/null && return 0
		[[ "$try" == 2 ]] || sleep 1
	done
	return 1
}

# The PR's head commit now, read again just before posting (one retry). Fails when GitHub can't say.
pr_head_now() {
	local json try
	for try in 1 2; do
		if json=$(gh pr view "$PR_NUM" --repo "$GH_HOST_NAME/$OWNER/$REPO" --json headRefOid 2>/dev/null) &&
			jq -er '.headRefOid | strings | select(. != "")' <<<"$json" 2>/dev/null; then
			return 0
		fi
		[[ "$try" == 2 ]] || sleep 1
	done
	return 1
}

if [[ "$POST_TO_PR" == "true" ]] && [[ -n "$REVIEW" ]]; then
	if [[ -z "$DECISION" && "${APPROACH_VERDICT:-}" == rethink ]]; then
		DECISION=request-changes
		echo "Approach: rethink → ${DECISION}"
	fi
	AUTO_DECISION=false
	if [[ -z "$DECISION" ]]; then
		AUTO_DECISION=true
		VERDICT=$(last_verdict 'ready to merge' "$CODE_REVIEW")
		# Only a bare "yes" approves; any qualifier ("yes, with fixes") falls through to comment.
		case "$VERDICT" in
		yes) DECISION=approve ;;
		no | "no "* | no[,\;\(—–-]*) DECISION=request-changes ;;
		*) DECISION=comment ;;
		esac
		echo "Verdict: ${VERDICT:-not found} → ${DECISION}"
		# An approval says the findings were checked; without a record nothing can show that, so only comment.
		if [[ "$DECISION" == approve && -z "${RECORD_FILE:-}" ]]; then
			DECISION=comment
			echo "No round record for this review: posting as comment, not approve."
		fi
	fi

	if [[ "$YES" == "false" ]]; then
		read -r -p "Post as review [c]omment, [a]pprove, [r]equest changes, or [N]o? (Enter = ${DECISION}) " confirm
		case "$confirm" in
		"") ;;
		[Cc]*) DECISION=comment AUTO_DECISION=false ;;
		[Aa]*) DECISION=approve AUTO_DECISION=false ;;
		[Rr]*) DECISION=request-changes AUTO_DECISION=false ;;
		*)
			echo "Aborted — review not posted."
			exit 0
			;;
		esac
	fi

	ME=${ME:-$(gh api --hostname "$GH_HOST_NAME" user --jq .login 2>/dev/null || true)}
	if [[ "$DECISION" != "comment" && "$ME" == "$PR_AUTHOR" ]]; then
		echo "Note: GitHub blocks ${DECISION} on your own PR; posting as comment."
		DECISION=comment
	fi

	# A round posted by someone else while this one ran: this one was reviewed without it, so it is never posted on top
	# of it. Read the history again first; when that read fails twice, nothing is posted either.
	if ! NOW_RECORDS=$(rounds_now); then
		echo "Error: could not read the PR's rounds again, so the history could not be verified; nothing was posted." >&2
		echo "    Session: ${SESSION_DIR}" >&2
		exit 1
	fi
	NOW_COUNT=$(jq 'length' <<<"$NOW_RECORDS")
	if [[ "$NOW_COUNT" != "$((ROUND - 1))" ]]; then
		echo "Not posted (exit 6): another round was posted while this review ran ($((ROUND - 1)) rounds then, ${NOW_COUNT} now):" >&2
		jq -r --argjson from "$((ROUND - 1))" '.[$from:][]
			| "    round \(.round) by \(.reviewer // "unknown") at \(.posted_at // "an unknown time")"' \
			<<<"$NOW_RECORDS" >&2
		echo "    Run the review again to review on top of it. Session: ${SESSION_DIR}" >&2
		exit 6
	fi

	# The review covers HEAD_SHA and is posted on it (commit_id). A push while it ran is not reviewed: never approve it.
	HEAD_NOTE=""
	if ! NOW_HEAD=$(pr_head_now); then
		echo "Could not read the PR's head before posting; this review covers ${HEAD_SHA:0:7}."
		HEAD_NOTE=unknown
	elif [[ "$NOW_HEAD" != "$HEAD_SHA" ]]; then
		HEAD_NOTE="The PR moved to ${NOW_HEAD:0:7} during the review; this review covers ${HEAD_SHA:0:7}."
		echo "$HEAD_NOTE"
		REVIEW=$(printf '**Note:** %s\n\n%s' "$HEAD_NOTE" "$REVIEW")
	fi
	if [[ -n "$HEAD_NOTE" && "$DECISION" == approve ]]; then
		DECISION=comment
		echo "Posting as comment, not approve: an approval must cover the PR's head."
	fi

	# The final record: round.json as posted.
	if [[ -n "${RECORD_FILE:-}" && -s "${RECORD_FILE:-}" ]] &&
		! jq --arg decision "$DECISION" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
			'.decision = $decision | .posted_at = $at | .preview = false' "$RECORD_FILE" >"$RECORD_FILE.posted"; then
		echo "Warning: could not write the posted round record; the review is posted without it." >&2
		rm -f "$RECORD_FILE.posted"
		RECORD_FILE=""
	fi
	# Right before posting: without a record, an automatic approve (the verdict's, or its default taken at the prompt)
	# posts as comment. An approve someone chose stays.
	if [[ "$DECISION" == approve && "$AUTO_DECISION" == true && -z "${RECORD_FILE:-}" ]]; then
		DECISION=comment
		echo "No round record for this review: posting as comment, not approve."
	fi

	MARKER=""
	if [[ -n "${RECORD_FILE:-}" && -s "${RECORD_FILE:-}.posted" ]]; then
		# The marker is sized for the exact body below: header, newline, marker, newline, review.
		if ! MARKER=$(marker_line "$RECORD_FILE.posted" "$REVIEW"); then
			MARKER=""
			echo "Warning: could not write the round marker; posting the review without it." >&2
		elif [[ -z "$MARKER" ]]; then
			echo "Warning: the review leaves no room for its round marker; posting it without one." >&2
			echo "    round.json keeps the full record: ${RECORD_FILE}" >&2
		fi
		[[ -z "$MARKER" ]] || MARKER+=$'\n'
	fi
	COMMENT=$(printf '<!-- gh-pr-review generated -->\n%s%s' "$MARKER" "$REVIEW")

	case "$DECISION" in
	approve) EVENT=APPROVE ;;
	request-changes) EVENT=REQUEST_CHANGES ;;
	*) EVENT=COMMENT ;;
	esac
	# Bound to the reviewed commit, so a push while the review ran is still unreviewed. The body goes through a file.
	printf '%s' "$COMMENT" | jq -Rs --arg commit "$HEAD_SHA" --arg event "$EVENT" \
		'{commit_id: $commit, event: $event, body: .}' >"${SESSION_DIR}/post.json"
	if ! gh api --hostname "$GH_HOST_NAME" --method POST "repos/$OWNER/$REPO/pulls/$PR_NUM/reviews" \
		--input "${SESSION_DIR}/post.json" >/dev/null; then
		echo "Error: GitHub did not take the review; nothing was posted. Session: ${SESSION_DIR}" >&2
		exit 1
	fi
	if [[ -n "${RECORD_FILE:-}" && -s "${RECORD_FILE:-}.posted" ]]; then
		mv "$RECORD_FILE.posted" "$RECORD_FILE"
	fi
	printf '%s\n' "$COMMENT" >"${SESSION_DIR}/posted.md"
	echo "✓  Posted → https://${GH_HOST_NAME}/${OWNER}/${REPO}/pull/${PR_NUM}"
fi
