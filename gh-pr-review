#!/usr/bin/env bash
# gh pr-review — AI code review for any GitHub PR
#
# Usage:
#   gh pr-review <PR-URL | PR-number> [options]
#   gh pr-review rounds <PR-URL | PR-number> [--json] [-u <login>]
#   gh pr-review --doctor
#
# Options:
#   --model <id>    Pi model ID (default: github-copilot/gpt-5.6-sol)
#   -u, --user <login>  gh account to use for this run only (global gh auth is untouched)
#   --no-post       Print review but don't post to GitHub
#   --skip-approach Skip the maintainer's approach pass; run the code review only
#   --instructions <text>  Extra guidance for both passes (a file: "$(cat notes.md)")
#   --decision <d>  comment | approve | request-changes (default: from "Ready to merge?")
#   -y, --yes       Skip confirmation prompts (a loop-check stop then exits 3, no new commits exits 5)
#   --check         Run only the loop check: print it and exit 0 (run), 3 (stop) or 5 (no new commits)
#   --json          With --check, print the decision as JSON
#   --force-round   Run a round even when the loop check stops it or nothing changed
#                   (in a terminal, without -y, both ask "Run round K anyway?" instead)
#   --doctor        Check all prerequisites and exit
#   -h, --help      Show this help
#
# Exit codes: 0 done, 1 error, 3 stopped by the loop check, 5 no new commits since the last round,
#   6 another round was posted while the review ran (nothing posted, the session is kept).
#
# Examples:
#   gh pr-review https://github.com/owner/repo/pull/42
#   gh pr-review 42                # infers repo from the current directory
#   gh pr-review 42 --model github-copilot/claude-sonnet-5 -y
#
# Environment:
#   GH_PR_REVIEW_MODEL          Default model override (same as --model)
#   GH_PR_REVIEW_PI_EXTENSION   Path to a pi extension to load during the review
#   GH_PR_REVIEW_USER           Default gh account (same as --user)
#   GITHUB_TOKEN                For private repos (gh auth is usually sufficient)

set -euo pipefail

# ── lib ─────────────────────────────────────────────────────────────────────
# Follow symlinks to the real script (`gh extension install .` links it), then load lib/*.sh.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
	LINK=$(readlink "$SELF")
	if [[ "$LINK" == /* ]]; then SELF="$LINK"; else SELF="$(dirname "$SELF")/$LINK"; fi
done
LIB_DIR="$(cd "$(dirname "$SELF")" && pwd)/lib"
for LIB_FILE in "$LIB_DIR"/*.sh; do
	# shellcheck source=/dev/null
	source "$LIB_FILE"
done

# ── subcommands ─────────────────────────────────────────────────────────────
# A known first word is a subcommand; anything else is a PR to review.
case "${1:-}" in
rounds | status | show | shepherd | dash | gc)
	SUBCOMMAND="$1"
	shift
	if declare -F "cmd_${SUBCOMMAND}" >/dev/null; then
		"cmd_${SUBCOMMAND}" "$@"
		exit $?
	fi
	echo "gh pr-review ${SUBCOMMAND}: not yet available" >&2
	exit 1
	;;
esac

# ── defaults ────────────────────────────────────────────────────────────────
MODEL="${GH_PR_REVIEW_MODEL:-github-copilot/gpt-5.6-sol}"
POST_TO_PR=true
DECISION=
YES=false
DOCTOR=false
TARGET=""
SKIP_APPROACH=false
INSTRUCTIONS=""
GH_USER="${GH_PR_REVIEW_USER:-}"
CHECK_ONLY=false
CHECK_JSON=false
FORCE_ROUND=false

# ── arg parsing ──────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
	case "$1" in
	--model | -m)
		[[ $# -lt 2 ]] && {
			echo "Error: --model requires a model ID" >&2
			exit 1
		}
		MODEL="$2"
		shift 2
		;;
	--user | -u)
		[[ $# -lt 2 ]] && {
			echo "Error: --user requires a gh login" >&2
			exit 1
		}
		GH_USER="$2"
		shift 2
		;;
	--instructions)
		[[ $# -ge 2 && -n "${2//[[:space:]]/}" && "$2" != --* ]] || {
			echo "Error: --instructions requires non-empty text (got: ${2:-nothing})" >&2
			exit 1
		}
		INSTRUCTIONS="$2"
		shift 2
		;;
	--skip-approach)
		SKIP_APPROACH=true
		shift
		;;
	--check)
		CHECK_ONLY=true
		shift
		;;
	--json)
		CHECK_JSON=true
		shift
		;;
	--force-round)
		FORCE_ROUND=true
		shift
		;;
	--no-post)
		POST_TO_PR=false
		shift
		;;
	--decision)
		[[ $# -ge 2 && "$2" =~ ^(comment|approve|request-changes)$ ]] || {
			echo "Error: --decision must be comment, approve or request-changes" >&2
			exit 1
		}
		DECISION="$2"
		shift 2
		;;
	-y | --yes)
		YES=true
		shift
		;;
	--doctor)
		DOCTOR=true
		shift
		;;
	-h | --help)
		sed -n '2,${/^#/!q;s/^# \{0,1\}//p;}' "$0"
		exit 0
		;;
	-*)
		echo "Unknown option: $1  (try --help)" >&2
		exit 1
		;;
	*)
		[[ -n "$TARGET" ]] && {
			echo "Extra argument: $1" >&2
			exit 1
		}
		TARGET="$1"
		shift
		;;
	esac
done

if [[ "$DOCTOR" == "false" && -z "$TARGET" ]]; then
	echo "Usage: gh pr-review <PR-URL | PR-number> [--model <id>] [--no-post] [--skip-approach] [-y] [--check [--json]] [--force-round] [--doctor]" >&2
	exit 1
fi
if [[ "$CHECK_JSON" == "true" && "$CHECK_ONLY" == "false" ]]; then
	echo "Error: --json only goes with --check" >&2
	exit 1
fi
# With --check --json, stdout carries the JSON only: everything else goes to stderr, the JSON to fd 3.
exec 3>&1
[[ "$CHECK_JSON" == "true" ]] && exec 1>&2

# ── per-run gh account (env token only; never runs `gh auth switch`) ─────────
use_gh_user "$GH_USER"

# ── pr context ─────────────────────────────────────────────────────────────────────
# The author's description and the discussion, as files both passes read after forming their own view.
write_pr_context() {
	local dir="$1" json threads
	mkdir -p "$dir"
	printf '# %s\n\n%s\n' "$PR_TITLE" "$PR_BODY" >"$dir/pr-body.md"
	json=$(gh pr view "$PR_NUM" --repo "$GH_HOST_NAME/$OWNER/$REPO" --json comments,reviews) || {
		echo "Error: could not fetch the PR discussion (check gh auth and network)." >&2
		exit 1
	}
	printf '%s\n' "$json" >"$dir/discussion.json"
	# shortcut: the first 100 comments per thread only; page them if real threads run longer.
	# shellcheck disable=SC2016 # $owner etc. are GraphQL variables, not shell ones
	threads=$(gh api graphql --hostname "$GH_HOST_NAME" --paginate \
		-f owner="$OWNER" -f name="$REPO" -F number="$PR_NUM" -f query='
		query($owner: String!, $name: String!, $number: Int!, $endCursor: String) {
		  repository(owner: $owner, name: $name) { pullRequest(number: $number) {
		    reviewThreads(first: 100, after: $endCursor) {
		      pageInfo { hasNextPage endCursor }
		      nodes { path line originalLine isResolved isOutdated
		        comments(first: 100) { totalCount nodes { author { login } body createdAt } } } } } } }') || {
		echo "Error: could not fetch the PR review threads (check gh auth and network)." >&2
		exit 1
	}
	{
		echo "# Conversation"
		echo ""
		jq -r '
			[(.comments[] | {who: .author.login, kind: "comment", at: .createdAt, body}),
			 (.reviews[] | {who: .author.login, kind: .state, at: .submittedAt, body})]
			| map(select((.body // "") != "")) | sort_by(.at)
			| if length == 0 then "(no comments or review summaries)"
			  else map("## \(.who) · \(.kind) · \(.at)\n\n\(.body)\n") | join("\n") end
		' <<<"$json"
		echo ""
		echo "# Inline review threads"
		echo ""
		jq -rs '
			[.[].data.repository.pullRequest.reviewThreads.nodes[]]
			| if length == 0 then "(no inline review threads)" else map(
				(.line // .originalLine) as $line | .comments.nodes as $c
				| (if .isResolved then "resolved" elif .isOutdated then "outdated" else "open" end) as $state
				| "## \(.path)\(if $line then ":\($line)" else "" end) · \($state)\n\n"
				+ (if .isResolved then
					"\($c[0].author.login): \(($c[0].body // "") | gsub("\\s+"; " ") | .[0:200])"
					+ (.comments.totalCount - 1 | if . == 0 then "" elif . == 1 then " (1 reply)"
					   else " (\(.) replies)" end)
				  else $c | map("**\(.author.login)** · \(.createdAt)\n\n\(.body)") | join("\n\n") end)
				+ "\n") | join("\n") end
		' <<<"$threads"
		echo ""
		echo "_Resolved threads show only the first 200 characters of the finding._"
	} >"$dir/pr-discussion.md"
}

# ── passes ──────────────────────────────────────────────────────────────────────────
# One headless pi call: prompt file in, model output file out. A failed call stops the run.
run_pi() {
	if ! pi "${PI_ARGS[@]}" "$(cat "$1")" >"$2"; then
		echo "" >&2
		echo "Error: pi exited with a non-zero status." >&2
		echo "    Check the session directory for details: ${SESSION_DIR}" >&2
		exit 1
	fi
}

# The run's extra guidance as a prompt section. Empty in, empty out.
instructions_section() {
	[[ -z "$INSTRUCTIONS" ]] && return 0
	printf '## Reviewer instructions\n\n'
	printf 'The person running this review added these instructions. Follow them where they conflict '
	printf 'with the default checklist. The output format, the verdict line and the read-only rule '
	printf 'still apply. Use them, but do not quote or mention them in your reply: it may be posted '
	printf 'on the PR.\n\n%s\n\n' "$INSTRUCTIONS"
}

# The posted body: the approach section, then the code review, then one footer. Empty in, empty out.
assemble_review() {
	local parts=() part
	for part in "$@"; do [[ -n "$part" ]] && parts+=("$part"); done
	[[ ${#parts[@]} -eq 0 ]] && return 0
	parts+=($'---\n'"*Review generated by gh pr-review · model: ${MODEL}*")
	printf '%s' "${parts[0]}"
	printf '\n\n%s' "${parts[@]:1}"
	printf '\n'
}
# ── end passes

# ── preflight ────────────────────────────────────────────────────────────────
PI_AUTH_FILE="${HOME}/.pi/agent/auth.json"
PREFLIGHT_FAILURES=0

pf_ok() {
	[[ "$DOCTOR" == "true" ]] && echo "✓ $1"
	return 0
}

pf_fail() {
	echo "✗ $1" >&2
	echo "  → $2" >&2
	PREFLIGHT_FAILURES=$((PREFLIGHT_FAILURES + 1))
}

run_preflight() {
	if command -v git &>/dev/null; then
		pf_ok "git installed"
	else
		pf_fail "git not found" \
			"macOS: xcode-select --install · Linux: install via your package manager"
	fi

	if command -v jq &>/dev/null; then
		pf_ok "jq installed"
	else
		pf_fail "jq not found" "macOS: brew install jq · Linux: apt/dnf install jq"
	fi

	if gh auth status -h github.com &>/dev/null; then
		pf_ok "gh authenticated"
	else
		pf_fail "gh not authenticated" "run: gh auth login"
	fi

	# --check reads GitHub only: it needs no model.
	[[ "$CHECK_ONLY" == "true" ]] && return 0

	if command -v pi &>/dev/null; then
		pf_ok "pi installed"
	else
		pf_fail "pi (pi-coding-agent) not found" \
			"run: npm install -g @earendil-works/pi-coding-agent  (requires Node 22+)"
	fi

	if [[ "$MODEL" == github-copilot/* ]]; then
		if command -v jq &>/dev/null && [[ -f "$PI_AUTH_FILE" ]] &&
			jq -e 'has("github-copilot")' "$PI_AUTH_FILE" &>/dev/null; then
			pf_ok "pi has GitHub Copilot credentials"
		else
			pf_fail "pi is not logged in to GitHub Copilot (model: ${MODEL})" \
				"run pi, then /login and pick GitHub Copilot — requires an active Copilot subscription"
		fi
	fi
}

run_preflight

if [[ "$DOCTOR" == "true" ]]; then
	if [[ "$PREFLIGHT_FAILURES" -eq 0 ]]; then
		echo ""
		echo "All checks passed — try: gh pr-review <PR-URL | PR-number>"
		exit 0
	fi
	exit 1
fi

if [[ "$PREFLIGHT_FAILURES" -gt 0 ]]; then
	echo "" >&2
	echo "Fix the issues above, then re-check with: gh pr-review --doctor" >&2
	exit 1
fi

# ── resolve owner/repo/PR number ─────────────────────────────────────────────
resolve_target "$TARGET"

# ── fetch PR metadata ────────────────────────────────────────────────────────
echo "🔍  PR #${PR_NUM} — ${OWNER}/${REPO}"
echo "    model: ${MODEL}"
echo ""

PR_JSON=$(gh pr view "$PR_NUM" --repo "$GH_HOST_NAME/$OWNER/$REPO" \
	--json title,body,headRefName,headRefOid,baseRefName,author,additions,deletions,changedFiles 2>&1) ||
	{
		echo "Error fetching PR (check gh auth): $PR_JSON" >&2
		exit 1
	}

PR_TITLE=$(echo "$PR_JSON" | jq -r '.title')
PR_BODY=$(echo "$PR_JSON" | jq -r '.body // "(no description provided)"')
PR_AUTHOR=$(echo "$PR_JSON" | jq -r '.author.login')
BASE_BRANCH=$(echo "$PR_JSON" | jq -r '.baseRefName')
ADDITIONS=$(echo "$PR_JSON" | jq -r '.additions')
DELETIONS=$(echo "$PR_JSON" | jq -r '.deletions')
N_FILES=$(echo "$PR_JSON" | jq -r '.changedFiles')

echo "    ${PR_TITLE}"
echo "    @${PR_AUTHOR}  ·  +${ADDITIONS} -${DELETIONS}  ·  ${N_FILES} files changed"
echo ""

# ── loop check ─────────────────────────────────────────────────────────────────────
# Earlier gh-pr-review reviews (by anyone) are earlier rounds. Before any clone or model call, decide whether this
# round should run: not when nothing changed, and not when the loop has stopped converging (see `gh pr-review rounds`).
HEAD_OID=$(echo "$PR_JSON" | jq -r '.headRefOid // empty')
RECORDS=$(fetch_round_records "$GH_HOST_NAME" "$OWNER" "$REPO" "$PR_NUM")
LIFTED=false
if [[ $(jq 'length' <<<"$RECORDS") -gt 0 ]]; then
	LIFTED=$(lifted_since "$GH_HOST_NAME" "$OWNER" "$REPO" "$PR_NUM" "$(jq -r 'last.posted_at // ""' <<<"$RECORDS")" "$PR_AUTHOR")
fi
PR_SHAPE=$(jq -cn --argjson lines "$((ADDITIONS + DELETIONS))" --argjson files "$N_FILES" '{lines: $lines, files: $files}')
LOOP=$(loop_decide_json "$RECORDS" "$PR_SHAPE" "$HEAD_OID" "$LIFTED" "{\"skip_approach\": $SKIP_APPROACH}")
LOOP_DECISION=$(jq -r '.decision' <<<"$LOOP")
ROUND=$(jq -r '.next_round' <<<"$LOOP")
PREVIOUS_RECORD=$(jq -c 'last // null' <<<"$RECORDS")
# New findings are numbered after the highest ID anywhere in the history, so an ID never restarts.
ID_FLOOR=$(jq -c -L "$LIB_DIR" 'include "records"; id_floor' <<<"$RECORDS")

if [[ "$CHECK_ONLY" == "true" ]]; then
	if [[ "$CHECK_JSON" == "true" ]]; then echo "$LOOP" >&3; else loop_text "$LOOP"; fi
	case "$LOOP_DECISION" in
	stop) exit 3 ;;
	nothing-new) exit 5 ;;
	*) exit 0 ;;
	esac
fi

FORCED=false
case "$LOOP_DECISION" in
nothing-new)
	if [[ "$FORCE_ROUND" == "true" ]]; then
		FORCED=true
		echo "    No new commits since round $((ROUND - 1)); running anyway (--force-round)."
	elif [[ -t 0 && "$YES" == "false" ]]; then
		# Someone may want a second opinion on the same commit: ask, as for a stop.
		echo "No new commits since round $((ROUND - 1)) (${HEAD_OID:0:7})."
		read -r -p "Run round ${ROUND} anyway? [y/N] " LOOP_ANSWER || LOOP_ANSWER=""
		[[ "$LOOP_ANSWER" == [Yy]* ]] || {
			echo "Nothing to review."
			exit 5
		}
		FORCED=true
	else
		echo "No new commits since round $((ROUND - 1)) (${HEAD_OID:0:7}): nothing to review. --force-round runs anyway."
		exit 5
	fi
	;;
stop)
	loop_text "$LOOP" >&2
	if [[ "$FORCE_ROUND" == "true" ]]; then
		FORCED=true
	elif [[ -t 0 && "$YES" == "false" ]]; then
		read -r -p "Run round ${ROUND} anyway? [y/N] " LOOP_ANSWER
		[[ "$LOOP_ANSWER" == [Yy]* ]] || {
			echo "Stopped by the loop check."
			exit 3
		}
		FORCED=true
	else
		echo "Stopped by the loop check (exit 3). --force-round runs anyway." >&2
		exit 3
	fi
	;;
warn)
	echo "    Loop: $(jq -r '.label + " (" + .reason + ")"' <<<"$LOOP")"
	;;
esac
# A loop that stopped converging says so at the top of the posted review.
LOOP_LINE=""
if jq -e '.label == "nit-loop" or .label == "churning"' <<<"$LOOP" >/dev/null; then
	LOOP_LINE=$(loop_line "$LOOP")
fi
echo "    round: ${ROUND}"
echo ""

# ── clone + checkout ─────────────────────────────────────────────────────────
SESSIONS_DIR="$(pwd)/pr-review-sessions"
mkdir -p "$SESSIONS_DIR"
SESSION_DIR=$(mktemp -d "${SESSIONS_DIR}/pr-review-XXXXX")
REVIEW_DIR="${SESSION_DIR}/repo"
PROMPT_FILE="${SESSION_DIR}/prompt.md"
OWNER_PROMPT_FILE="${SESSION_DIR}/owner-prompt.md"
APPROACH_FILE="${SESSION_DIR}/approach.md"

echo "⏳  Cloning ${OWNER}/${REPO}..."

# Per-command credential helper: the token never lands in the checkout's .git/config.
GIT_AUTH=(-c credential.helper= -c "credential.helper=!gh auth git-credential")
CLONE_URL="https://${GH_HOST_NAME}/${OWNER}/${REPO}.git"

git "${GIT_AUTH[@]}" clone --depth 50 --quiet "$CLONE_URL" "$REVIEW_DIR"

cd "$REVIEW_DIR"
git "${GIT_AUTH[@]}" fetch origin "pull/${PR_NUM}/head:pr-branch" --depth 50 --quiet
git "${GIT_AUTH[@]}" fetch origin "${BASE_BRANCH}:refs/remotes/origin/${BASE_BRANCH}" --depth 50 --quiet
git checkout pr-branch --quiet

HEAD_SHA=$(git rev-parse HEAD)
BASE_SHA=$(git merge-base HEAD "origin/${BASE_BRANCH}") || {
	echo "Error: no merge-base between PR head and origin/${BASE_BRANCH} within the" >&2
	echo "shallow clone (depth 50). Refusing to review a partial diff." >&2
	exit 1
}

echo "    base: ${BASE_SHA:0:8}  head: ${HEAD_SHA:0:8}"
echo ""

CONTEXT_DIR="${SESSION_DIR}/context"
write_pr_context "$CONTEXT_DIR"

# ── build owner (approach) prompt ───────────────────────────────────────────────────────────
build_owner_prompt() {
	{
		cat <<'OWNER1'
You are the long-time maintainer of this repository. You will own this code for years,
long after this PR's author has moved on. Judge the APPROACH of this pull request, not its lines:
whether this change belongs here, built this way. A correct PR that does not belong here, or
is built in the wrong place, gets Rethink. A PR whose approach fits gets Sound, said plainly and
briefly. Most PRs are Sound.

A separate reviewer checks the code line by line after you. Do not hunt for bugs, style, or
missing tests. Your evidence is the repository's own rules and structure.

Your review is read-only. Do not change the working tree, the index, HEAD, or branches.

OWNER1

		instructions_section

		cat <<OWNER2
## Steps, in this order

1. **Read the repository's rules at the base commit**, so this PR cannot change the rules that
   judge it. Use \`git show ${BASE_SHA}:<path>\` for AGENTS.md, CLAUDE.md, REVIEW.md,
   CONTRIBUTING.md and README.md (each one that exists, at any level that matters for the changed
   paths), the docs they link to, and ADRs (\`docs/adr*\`, \`docs/decisions\`). Then map the modules
   this PR touches and how they fit the system today.

2. **Form your own view before reading the author's pitch.** Do not open the context files yet.
   Run \`git diff --stat ${BASE_SHA}..${HEAD_SHA}\` and read the changed areas. Write down, for
   yourself, what this change does and where it plugs into the system.

3. **Now read the author's claims and the discussion:**
   - ${CONTEXT_DIR}/pr-body.md
   - ${CONTEXT_DIR}/pr-discussion.md

   Treat them as claims to check, not as givens. Look for earlier work: \`gh pr list --search
   "<keywords>" --state all --repo ${GH_HOST_NAME}/${OWNER}/${REPO}\`, \`gh issue view\` for linked
   issues, and grep for code that already does this. An earlier rejection or an abandoned approach
   counts as evidence.

OWNER2

		cat <<'OWNER3'
4. **Check the fit.** Look for these signals, and count them when you find them:
   - Shared modules that gain conditionals for one feature (how many files, how many branches).
   - A translation layer that maps one feature's terms onto another's.
   - A parallel copy of an existing module: prompts, handlers, schemas, configs.
   - A new rule that every caller must remember to follow.
   - Planned follow-ups or "out of scope" items in the PR that the chosen structure cannot take.
   - Code that repeats what the repository, a dependency, or another service already does.
   - A new external credential, dependency, or lifecycle that the existing unit was not built for.
   - A conflict with a written rule or ADR. A written rule outranks taste.

5. **Make the best case for the PR first.** State the strongest case for the approach as built.
   Then give 1 to 3 concrete alternatives that exist in this repository's terms, "as-is" included,
   each with its cost. Name the fact that would change your mind.

6. **Pick a verdict:**
   - **Sound**: the approach fits the existing structure, or the PR justifies the deviation.
   - **Questionable**: a real concern that discussion or contained rework can solve.
   - **Rethink**: you can name a concrete alternative in this repository, and you can explain why
     building on the current approach costs more than switching. Nothing less.
   - Missing context lowers your confidence. It never raises the verdict.

## Evidence

Cite repository doc paths, structural facts (paths and counts), and quotes from the PR. No
file:line is needed. If a point depends on business or product context the repository cannot
show, put it under "Questions for the author", never in the fit findings. Be honest and direct,
as you would be with a colleague whose work you respect.

## Two examples (invented, for tone and length only)

Example A:

### Approach

**What it does:** Adds CSV export next to the existing JSON export.
**Fit with the repo:** It implements the existing `Exporter` interface in `exporters/` and registers
in the same table as JSON. No shared module changes.
**Strongest case for the approach as built:** It is the documented extension point (README "Exporters").
**Alternatives:** None worth the change.
**Questions for the author:** None.
**Missing context:** None.

**Approach:** Sound

Example B:

### Approach

**What it does:** Adds a hand-written retry loop and a second HTTP client to the billing handler.
**Fit with the repo:** `AGENTS.md` requires every outbound call to use `lib/http` (shared client
with retries, timeouts and tracing). This PR bypasses it in one handler; 14 other handlers use it.
**Strongest case for the approach as built:** Billing needs a longer timeout than the default.
**Alternatives:** (1) Use `lib/http` with a per-call timeout option, which it already accepts: about
10 lines, keeps tracing. (2) As-is: a second retry policy to maintain, and billing calls disappear
from traces.
**Questions for the author:** Is there a need `lib/http` cannot meet?
**Missing context:** None.

**Approach:** Rethink

## Output

Reply with this section only, filled in. Keep it short when the approach is Sound.

### Approach

**What it does:** …
**Fit with the repo:** …
**Strongest case for the approach as built:** …
**Alternatives:** …
**Questions for the author:** …
**Missing context:** …

**Approach:** Sound | Questionable | Rethink
OWNER3
	} >"$OWNER_PROMPT_FILE"
}

# ── build review prompt (temp file — no quoting issues) ──────────────────────
build_prompt() {
	{
		# Part 1: static header (quoted heredoc — zero expansion)
		cat <<'PART1'
You are a Senior Code Reviewer with expertise in software architecture,
design patterns, and best practices. Your job is to review completed work against
its PR description and identify issues before they are merged.

## What Was Implemented

PART1

		# Part 2: dynamic PR metadata (printf — safe for any content)
		printf 'PR #%s by @%s: %s\n\n' "$PR_NUM" "$PR_AUTHOR" "$PR_TITLE"
		printf '## Requirements / Plan\n\n%s\n\n' "$PR_BODY"

		if [[ -s "$APPROACH_FILE" ]]; then
			printf "## Maintainer's approach notes\n\n"
			printf 'A maintainer already judged the approach. Do not argue it again. '
			printf 'Review the implementation.\n\n%s\n\n' "$(cat "$APPROACH_FILE")"
		fi

		instructions_section

		printf '## PR Discussion\n\n'
		printf 'Before you report findings, read %s/pr-discussion.md: comments, review summaries ' "$CONTEXT_DIR"
		printf '(earlier gh pr-review runs included) and inline review threads. Treat them as claims to '
		printf 'check against the code. A point that was fixed, resolved, or declined with a reason is '
		printf 'settled: raise it again only with new evidence from the current code, and say what '
		printf 'changed.\n\n'

		# Part 3: git range (unquoted heredoc — expands $BASE_SHA/$HEAD_SHA only)
